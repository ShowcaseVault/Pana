# Base URL of the Pana API. Must match an entry in the backend's
# ALLOWED_ORIGINS, and carries no trailing slash.
VITE_BASE_API_URL=http://localhost:8000

# Dev server port. Changing it means updating ALLOWED_ORIGINS on the backend.
VITE_PORT=5173

# Extra Host headers the dev server accepts, comma-separated. Empty is fine for
# localhost; set it when reaching the app through a tunnel or a LAN address.
VITE_ALLOWED_HOSTS=
