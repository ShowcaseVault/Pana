# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Build output
# Dependencies live in the workspace root's node_modules, and the root
# .gitignore covers them. Kept here only for a stray install run inside
# this directory.
node_modules
dist
dist-ssr
*.local

# Vite's pre-bundled dependency cache, rewritten on every dev server start.
.vite/

# Environment
.env
.env.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.sw?

# Superseded by the workspace root lockfile.
package-lock.json
