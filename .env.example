# ENVIRONMENT
ENV=local
# RECORDINGS
RECORDINGS_DIR=recordings
# CLIENT
CLIENT_URL=http://localhost:5173
# Comma-separated browser origins allowed to call the API (no trailing path).
ALLOWED_ORIGINS=http://localhost:5173
# DATABASE
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=
# REDIS
REDIS_PASSWORD='<pass>'
REDIS_HOST='redis-pana' # redis container name
REDIS_PORT=6379
REDIS_BROKER_URL='redis://:<pass>@localhost:6379/0'
REDIS_RESULT_BACKEND='redis://:<pass>@localhost:6379/1'
REDIS_PUBSUB_URL='redis://:<pass>@localhost:6379/2'
REDIS_CACHE_URL='redis://:<pass>@localhost:6379/3'

# ---- STT: speech in (Groq / Whisper) ----
# Uploaded audio gets the accurate model, a live call the turbo one.
STT_MODEL=whisper-large-v3
STT_MODEL_REALTIME=whisper-large-v3-turbo

# ---- LLM: the reply (Groq) ----
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_MODEL_REALTIME=openai/gpt-oss-120b

# ---- TTS: speech out (NVIDIA Magpie) ----
# Hosted on NVIDIA Cloud Functions by default. For a self-hosted NIM
# (docker-compose.magpie.yml): TTS_URI=localhost:50051, TTS_USE_SSL=false,
# and leave TTS_FUNCTION_ID empty.
NVIDIA_API_KEY=
TTS_URI=grpc.nvcf.nvidia.com:443
TTS_FUNCTION_ID=877104f7-e885-42b9-8de8-f6e4c6303969
TTS_USE_SSL=true
TTS_VOICE=Magpie-Multilingual.EN-US.Sofia
TTS_LANGUAGE=en-US

# ---- Voice pipeline ----
# Which implementation each stage of a live call uses. "local" forces the
# offline Vosk/Piper path: no key, no network.
VOICE_STT_PROVIDER=groq
VOICE_LLM_PROVIDER=groq
VOICE_TTS_PROVIDER=magpie

# LANGSMITH
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pr-clear-unique-1
# GOOGLE OAUTH - panaa
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# JWT authentication
JWT_ACCESS_SECRET_KEY=""
JWT_REFRESH_SECRET_KEY=""
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=
ACCESS_COOKIE_NAME="access_token"
REFRESH_COOKIE_NAME="refresh_token"
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"

# TELEPHONY
# Asterisk ARI, the control channel used by the voice service. Asterisk and the
# voice service both read ARI_PASSWORD from here, and neither starts without
# it. ARI can originate calls, so treat it like any other credential and
# generate it: openssl rand -hex 32
ARI_BASE_URL=http://127.0.0.1:8088
ARI_USERNAME=pana
ARI_PASSWORD=
ARI_APP_NAME=pana-voice

# Concurrent calls allowed on the SIP trunk. This is the cost ceiling if the
# trunk credentials ever leak: no attacker can place more calls at once than
# this. The credentials themselves are NOT here -- they live in
# secrets/sip_trunk.env. See docs/telephony.md.
SIP_MAX_CHANNELS=2

# Maximum length of any single call, in seconds. A call still up at this point
# is hung up. Bounds both carrier minutes and the channel plus media session
# held open on our side.
SIP_MAX_CALL_SECONDS=180
