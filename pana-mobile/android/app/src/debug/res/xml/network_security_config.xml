<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext for the debug build.

  A development API is plain HTTP on a LAN, which Android refuses by default.
  The previous version of this file named one address, which worked only for
  the machine that happened to build the APK; a debug build handed to anyone
  else could not reach their server. Since the build already lets the origin
  be typed in at runtime, the permission has to be as broad as the field.

  This file is in the debug source set. The release build has its own, which
  permits no cleartext at all, and its bundle has no way to change the origin,
  so nothing here reaches a shipped app.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
