<?xml version="1.0" encoding="utf-8"?>
<!--
  The development API is plain HTTP on the LAN, which Android refuses by
  default. Cleartext is opened for the development hosts only, so a release
  build talking to anything else still requires HTTPS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.1.11</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
