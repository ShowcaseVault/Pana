<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>

        <!-- Painted before the activity's launch theme applies. Left at the
             parent's default this window is white, which is the first of the
             flashes the user sees on a cold start. -->
        <item name="android:windowBackground">@color/launch_background</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>

        <!-- The window the web view sits on. Without this the gap between the
             launch window going away and the bundle painting shows black. -->
        <item name="android:windowBackground">@color/launch_background</item>
    </style>


    <!--
      The launch window, shown for the moment between the process starting and
      the web view drawing. Capacitor ships an image here; Pana paints the
      app's own ground colour instead, so the splash the user sees is the one
      the app draws rather than a system image handing over to it.
    
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@color/launch_background</item>
        <item name="windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowBackground">@color/launch_background</item>

        <!-- The theme the window becomes once the splash is dismissed. Without
             it the activity falls back to its own default background for a
             frame. -->
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>