# Dependencies live in the workspace root's node_modules, and the root
# .gitignore covers them. Kept here only for a stray install run inside
# this directory.
node_modules/
dist/

# Built APKs. Binaries do not belong in the repository; a build is
# reproducible from source, and an APK is tens of megabytes per version.
#
# Anchored to this directory: unanchored, `release/` also matches the Android
# release source set, whose manifest and network config are source and must be
# tracked.
/release/

# Superseded by the workspace root lockfile.
package-lock.json

# The native projects carry their own .gitignore, generated by Capacitor from
# the platform's standard template -- android/.gitignore already covers build
# output, .gradle, local.properties, and the web assets copied in on each sync.
# Nothing is repeated here, so those files stay correct when Capacitor updates
# them.
#
# What IS tracked under android/ is the part edited by hand: the manifest, the
# network security config, the launcher icons, and the Gradle wrapper -- the
# wrapper especially, since `./gradlew` is how the project builds without
# Gradle installed.
