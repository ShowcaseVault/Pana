# Backend only.
#
# pana-app/ and pana-landing/ carry their own .gitignore for their build
# output and caches. Keeping the three separate means each directory can be
# split into its own repository without losing the rules that apply to it.

# Environment
.env
**/.env

# Python
__pycache__/
**/__pycache__/
*.py[cod]

# Node
#
# The frontends are npm workspaces, so there is one node_modules at the root
# rather than one per app. The per-project entries cover a stray install run
# inside an app directory.
node_modules/
*/node_modules/

# uv / virtualenv
.venv/

# Tooling caches
.ruff_cache/
.pytest_cache/

# Claude
CLAUDE.md
.claude/

# Local data and scratch
test.py
logs
misc/
recordings/
*.local

# Generated speech handed to Asterisk, one file per turn.
var/
