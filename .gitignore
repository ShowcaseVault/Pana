# Backend only.
#
# pana-app/ and pana-landing/ carry their own .gitignore for their build
# output and caches. Keeping the three separate means each directory can be
# split into its own repository without losing the rules that apply to it.

# Environment
.env
**/.env

# Python
__pycache__/
**/__pycache__/
*.py[cod]

# uv / virtualenv
.venv/

# Tooling caches
.ruff_cache/
.pytest_cache/

# Claude
CLAUDE.md
.claude/

# Local data and scratch
test.py
logs
misc/
recordings/
*.local

# Speech models, fetched with make voice-models. A few hundred MB of binary.
models/
# Generated speech handed to Asterisk, one file per turn.
var/
