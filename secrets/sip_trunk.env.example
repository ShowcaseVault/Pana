# Carrier SIP trunk credentials.
#
# Copy to secrets/sip_trunk.env and fill in the values your carrier gave you.
# That file is git-ignored, is never baked into an image, and is mounted into
# the Asterisk container read-only. Keep it chmod 600.
#
# Never copy these values into .env: .env is read by the FastAPI application
# and by Celery, neither of which needs the SIP password. Asterisk is the only
# process that should ever see it.

# The username used in the SIP From/Contact user part (often the DID or a
# subscriber id).
SIP_USERNAME=

# The password for the trunk registration. Treat as a live payment credential.
SIP_PASSWORD=

# The authentication username, when the carrier issues one distinct from
# SIP_USERNAME. If your carrier did not give you a separate value, set this to
# the same value as SIP_USERNAME.
SIP_AUTH_NAME=

# The carrier's SIP domain, e.g. sip.carrier.example. Host only, no scheme.
SIP_DOMAIN=

# The outbound proxy, host or host:port, e.g. proxy.carrier.example:5060.
# Signalling is sent here rather than resolved from SIP_DOMAIN.
SIP_OUTBOUND_PROXY=

# The transport to the carrier: udp, tcp, or tls. Prefer tls when the carrier
# supports it, since udp and tcp send the auth exchange in the clear.
SIP_TRANSPORT=udp

# Optional. The public IP and local subnet of this host, needed only when
# Asterisk sits behind NAT. Leave both empty when the host has a public IP.
SIP_EXTERNAL_IP=
SIP_LOCAL_NET=

# Optional. Extra carrier addresses or CIDR ranges allowed to send us calls,
# comma-separated, e.g. "203.0.113.0/24,198.51.100.7". Needed when the carrier
# signals from more addresses than SIP_OUTBOUND_PROXY. Ask the carrier for the
# list; every entry here may place calls into our dialplan.
SIP_IDENTIFY_EXTRA=
